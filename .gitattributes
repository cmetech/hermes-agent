# Auto-generated files — collapse diffs and exclude from language stats
web/package-lock.json linguist-generated=true

# Enforce LF for scripts that run inside Linux containers.
# Without this, Windows checkout converts to CRLF and breaks `exec` in the
# container entrypoint with "no such file or directory".
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
docker/entrypoint.sh text eol=lf

# Authenticated workflow resources are hashed byte-for-byte. Git for Windows
# must never rewrite their LF bytes to CRLF or a clean managed checkout will
# fail distribution digest verification before capability defaults are seeded.
capabilities/workflow-packages/** text eol=lf
capabilities/workflows/** text eol=lf
plugins/workflow/showcases/** text eol=lf
tests/plugins/workflow/fixtures/store/**/*.json text eol=lf
tests/plugins/workflow/fixtures/store/**/*.jsonl text eol=lf
tests/plugins/workflow/fixtures/store/**/*.yaml text eol=lf
tests/plugins/workflow/fixtures/store/**/*.txt text eol=lf
