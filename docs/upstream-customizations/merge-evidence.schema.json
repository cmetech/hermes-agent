{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.dev/schemas/workflow-merge-evidence-v1.json",
  "type": "object",
  "required": [
    "schema_version",
    "prior_upstream_commit",
    "candidate_upstream_commit",
    "pre_base_commit",
    "post_base_commit",
    "tested_base_tree",
    "ledger_baseline",
    "ledger_sha256",
    "patch_sha256",
    "merge_skill",
    "entries",
    "commands",
    "platform",
    "brands",
    "final_ancestry"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "prior_upstream_commit": {"$ref": "#/$defs/sha"},
    "candidate_upstream_commit": {"$ref": "#/$defs/sha"},
    "pre_base_commit": {"$ref": "#/$defs/sha"},
    "post_base_commit": {"$ref": "#/$defs/sha"},
    "tested_base_tree": {"$ref": "#/$defs/sha"},
    "ledger_baseline": {"$ref": "#/$defs/sha"},
    "ledger_sha256": {"$ref": "#/$defs/digest"},
    "patch_sha256": {"$ref": "#/$defs/digest"},
    "merge_skill": {"$ref": "#/$defs/mergeSkill"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "platform": {"type": "string", "minLength": 1, "maxLength": 128},
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/brand"}
    },
    "final_ancestry": {"const": true}
  },
  "additionalProperties": false,
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeText": {
      "type": "string",
      "maxLength": 512,
      "not": {"pattern": "(?i)(token|secret|password|prompt|workflow_input)\\s*[=:]"}
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "command": {
      "type": "object",
      "required": ["name", "result", "duration_ms", "platform"],
      "properties": {
        "name": {"$ref": "#/$defs/safeText"},
        "result": {"enum": ["passed", "failed"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "platform": {"$ref": "#/$defs/safeText"}
      },
      "additionalProperties": false
    },
    "executedTest": {
      "type": "object",
      "required": [
        "kind",
        "name",
        "path",
        "result",
        "duration_ms",
        "platform",
        "attempts",
        "flaky_on_first_attempt"
      ],
      "properties": {
        "kind": {"const": "executed"},
        "name": {"$ref": "#/$defs/safeText"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "result": {"enum": ["passed", "failed"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "platform": {"$ref": "#/$defs/safeText"},
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/testAttempt"}
        },
        "flaky_on_first_attempt": {"type": "boolean"}
      },
      "oneOf": [
        {
          "properties": {
            "result": {"const": "passed"},
            "flaky_on_first_attempt": {"const": false},
            "attempts": {
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "properties": {
                    "attempt": {"const": 1},
                    "result": {"const": "passed"}
                  }
                }
              ]
            }
          }
        },
        {
          "properties": {
            "result": {"const": "passed"},
            "flaky_on_first_attempt": {"const": true},
            "attempts": {
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "properties": {
                    "attempt": {"const": 1},
                    "result": {"const": "failed"}
                  }
                },
                {
                  "properties": {
                    "attempt": {"const": 2},
                    "result": {"const": "passed"}
                  }
                }
              ]
            }
          }
        },
        {
          "properties": {
            "result": {"const": "failed"},
            "flaky_on_first_attempt": {"const": false},
            "attempts": {
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "properties": {
                    "attempt": {"const": 1},
                    "result": {"const": "failed"}
                  }
                },
                {
                  "properties": {
                    "attempt": {"const": 2},
                    "result": {
                      "enum": [
                        "failed",
                        "timed_out",
                        "signaled",
                        "infrastructure_error"
                      ]
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "properties": {
            "result": {"const": "failed"},
            "flaky_on_first_attempt": {"const": false},
            "attempts": {
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "properties": {
                    "attempt": {"const": 1},
                    "result": {
                      "enum": ["timed_out", "signaled", "infrastructure_error"]
                    }
                  }
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "testAttempt": {
      "oneOf": [
        {
          "type": "object",
          "required": ["attempt", "result", "duration_ms", "output_truncated"],
          "properties": {
            "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
            "result": {
              "enum": ["passed", "failed", "timed_out", "infrastructure_error"]
            },
            "duration_ms": {"type": "integer", "minimum": 0},
            "output_truncated": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "attempt",
            "result",
            "duration_ms",
            "output_truncated",
            "termination_signal"
          ],
          "properties": {
            "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
            "result": {"const": "signaled"},
            "duration_ms": {"type": "integer", "minimum": 0},
            "output_truncated": {"type": "boolean"},
            "termination_signal": {"type": "integer", "minimum": 1, "maximum": 255}
          },
          "additionalProperties": false
        }
      ]
    },
    "referenceTest": {
      "type": "object",
      "required": ["kind", "name", "path", "reason"],
      "properties": {
        "kind": {"const": "reference"},
        "name": {"$ref": "#/$defs/safeText"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "reason": {"const": "non-executable invariant reference"}
      },
      "additionalProperties": false
    },
    "mergeSkill": {
      "type": "object",
      "required": ["path", "sha256", "owner_commit"],
      "properties": {
        "path": {"$ref": "#/$defs/safeText"},
        "sha256": {"$ref": "#/$defs/digest"},
        "owner_commit": {
          "oneOf": [
            {"$ref": "#/$defs/sha"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "baseline",
        "files",
        "patch_sha256",
        "overlap_class",
        "overlap_policy",
        "decision_required",
        "decision",
        "conflict_files",
        "retained_commit_subjects",
        "removed_commit_subjects",
        "tests"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/safeText"},
        "baseline": {"$ref": "#/$defs/sha"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "patch_sha256": {"$ref": "#/$defs/digest"},
        "overlap_class": {
          "enum": ["none", "same_file", "owned_symbol"]
        },
        "overlap_policy": {"enum": ["owned_symbol", "any_owned_file"]},
        "decision_required": {"type": "boolean"},
        "decision": {
          "enum": ["not-required", "preserve", "adapt", "remove-as-upstream-equivalent"]
        },
        "conflict_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "retained_commit_subjects": {
          "type": "array",
          "items": {"$ref": "#/$defs/safeText"}
        },
        "removed_commit_subjects": {
          "type": "array",
          "items": {"$ref": "#/$defs/safeText"}
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/executedTest"},
              {"$ref": "#/$defs/referenceTest"}
            ]
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "overlap_class": {"const": "owned_symbol"},
            "decision_required": {"const": true},
            "decision": {
              "enum": ["preserve", "adapt", "remove-as-upstream-equivalent"]
            }
          }
        },
        {
          "properties": {
            "overlap_class": {"const": "same_file"},
            "overlap_policy": {"const": "any_owned_file"},
            "decision_required": {"const": true},
            "decision": {
              "enum": ["preserve", "adapt", "remove-as-upstream-equivalent"]
            }
          }
        },
        {
          "properties": {
            "overlap_class": {"const": "same_file"},
            "overlap_policy": {"const": "owned_symbol"},
            "decision_required": {"const": false},
            "decision": {"const": "not-required"}
          }
        },
        {
          "properties": {
            "overlap_class": {"const": "none"},
            "decision_required": {"const": false},
            "decision": {"const": "not-required"}
          }
        }
      ],
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "required": [
        "ref",
        "commit",
        "tree",
        "descriptor_sha256",
        "contains_tested_base",
        "generic_runtime_matches_base"
      ],
      "properties": {
        "ref": {"$ref": "#/$defs/safeText"},
        "commit": {"$ref": "#/$defs/sha"},
        "tree": {"$ref": "#/$defs/sha"},
        "descriptor_sha256": {"$ref": "#/$defs/digest"},
        "contains_tested_base": {"const": true},
        "generic_runtime_matches_base": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
